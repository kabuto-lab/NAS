# AX•CMS · split-pool environment reference · ENTITY §3.4.2
#
# This file is a REFERENCE DOCUMENT, not a working .env.  The spine
# (.env.example — ENTITY §12) describes the single-pool baseline.
# When the §3.4.2 split-pool topology is active (docker-compose.override.yml
# mounts ops/pgbouncer/*.ini), set these three DATABASE_URL_* values so
# apps/server/main.rs (BootConfig) routes traffic to the right logical pool.
#
# Why three URLs instead of one + pool labels?
#   • PgBouncer multiplexes per logical database alias.  Routing through
#     `http_pool` (vs `worker_pool`/`admin_pool`) pins the request to
#     the correct pool budget without runtime conditionals in app code.
#   • Failure isolation: a runaway worker cannot exhaust http_pool slots.
#   • Operability: `SHOW POOLS;` in psql against pgbouncer surfaces
#     per-alias backend counts that map 1:1 to the application's
#     concurrency story.

# ── Logical-pool URLs (route via PgBouncer on host port 6450) ────────────
# Format: postgres://<user>:<pass>@<host>:<pgbouncer-port>/<logical-alias>
DATABASE_URL_HTTP=postgres://postgres:ax_dev_pw@localhost:6450/http_pool
DATABASE_URL_WORKER=postgres://postgres:ax_dev_pw@localhost:6450/worker_pool
DATABASE_URL_ADMIN=postgres://postgres:ax_dev_pw@localhost:6450/admin_pool

# ── Per-pool max_connections on the application side ─────────────────────
# These bound the sqlx PoolBuilder size.  Combined ceiling must stay <=
# PgBouncer's `max_client_conn` (1000) and the sum of `pool_size` for the
# three aliases (40) so the validator gate passes on each cold start.
DB_HTTP_POOL_SIZE=25
DB_WORKER_POOL_SIZE=10
DB_ADMIN_POOL_SIZE=5

# ── Migration / ops shortcut (bypasses PgBouncer for DDL) ────────────────
# DDL must NOT go through transaction-mode pooling (long-held connections
# break the multiplexing contract).  Use the direct port 5450 for `db
# migrate`, `db seed-dev`, and the `nas2-cli` admin commands.
DATABASE_URL_DIRECT=postgres://postgres:ax_dev_pw@localhost:5450/ax_cms_dev

# ── Shutdown bound ───────────────────────────────────────────────────────
# apps/server BoundConfig.shutdown_grace — see P1 S4.
SHUTDOWN_GRACE_SECS=30

# ── Observability ────────────────────────────────────────────────────────
# When set, crates/runtime/observability.rs activates the OTLP exporter
# and the Prometheus HTTP listener (default 9000).
OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9000
LOG_LEVEL=info
