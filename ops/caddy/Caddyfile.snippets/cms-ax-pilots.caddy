# cms-ax-pilots.caddy · Caddy routing snippet для AX cms_pages pilot
#
# Per ADR-001 §D9 + bridge/03 §12. Routes GET on `/api/v1/cms/pages/public/by-slug/*`
# для whitelisted tenant hosts на AX server (port 7000). Все остальные пути
# (write, admin, не-whitelisted hosts) — на SITE1 (default Next.js / Nest API).
#
# Usage (в основном Caddyfile):
#
#   spa.me, *.spa.me {
#     import cms_ax_pilots
#     reverse_proxy site1-web:3011         # fallback всё, что не AX
#   }
#
# Rollback (< 5 min per ENTITY §12.6.5):
#   1. Comment out `import cms_ax_pilots` в main Caddyfile
#   2. `caddy reload` (graceful, drains in-flight)
#   3. Verify SITE1 serving requests (curl test)

(cms_ax_pilots) {
    @ax_cms_pilots {
        host imperiumspa.spa.me                # Pilot tenant #1 (Phase A)
        # host pentagon.spa.me                  # Phase B: добавить
        # host barbiespa.spa.me                 # Phase B: добавить
        # host roxy-spa.spa.me                  # Phase B: добавить
        method GET
        path /api/v1/cms/pages/public/by-slug/*
    }

    handle @ax_cms_pilots {
        reverse_proxy ax-server:7000 {
            # Health check — Caddy исключает upstream если /health отвечает != 2xx
            health_uri /health
            health_interval 5s
            health_timeout 1s
            fail_duration 30s
            max_fails 3
            unhealthy_status 500 503

            # Transport tuning для low-latency reads
            transport http {
                keepalive 30s
                keepalive_idle_conns 10
                response_header_timeout 5s
                read_buffer 8192
                write_buffer 8192
            }

            # Header injection для diagnostic correlation
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            # X-Tenant-Slug проставляется AX'ом из Host, но дублируем явно
            # для случаев когда AX резолвит через subdomain detection
        }
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Health probe override (опционально — для standalone AX testing без main Caddyfile)
# ─────────────────────────────────────────────────────────────────────────────
# Этот блок ТОЛЬКО для отладки. В production main Caddyfile включает import.
#
# pilot-cms-ax.spa.me {
#     import cms_ax_pilots
#     reverse_proxy ax-server:7000
# }
